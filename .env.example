# Copie este arquivo para ".env" (na raiz do projeto, ao lado do manage.py)
# e preencha com os dados do SEU ambiente. O arquivo ".env" não vai para o Git.

SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco MySQL / MariaDB
DB_NAME=swap
DB_USER=root
DB_PASSWORD=sua-senha
DB_HOST=127.0.0.1
DB_PORT=3306

# Cloudinary (armazenamento das fotos). Obrigatórias para o Django iniciar.
CLOUDINARY_CLOUD_NAME=seu-cloud-name
CLOUDINARY_API_KEY=sua-api-key
CLOUDINARY_API_SECRET=seu-api-secret
